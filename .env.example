# =============================================================================
# ELITEBUILD — Environment Variables
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================================

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://user:password@localhost:5432/elitebuild?schema=public"

# Authentication
AUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ELITE CONSTRUCTION COMPANY"

# Storage Provider: "local" | "s3"
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="elitebult-storage"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Secure private document storage (path relative to project root or absolute)
PRIVATE_STORAGE_ROOT="storage/documents"

# Email (optional)
EMAIL_FROM=""
EMAIL_SERVER=""

# Admin Seed (used only during initial seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="30"

# =============================================================================
# RAG Configuration: Dual Modes ("trial" | "production")
# =============================================================================
RAG_MODE="trial"

# Production Mode FastAPI Endpoint & Key
RAG_SERVICE_URL="http://127.0.0.1:8000"
RAG_SERVICE_API_KEY=""

# Cloudflare Workers AI (Trial Mode Embeddings & Reranker)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_API_TOKEN=""
EMBEDDING_PROVIDER="cloudflare"
EMBEDDING_MODEL="@cf/baai/bge-small-en-v1.5"
VECTOR_DIMENSION="384"

RERANKER_PROVIDER="cloudflare"
RERANKER_MODEL="@cf/baai/bge-reranker-base"

# Groq Cloud API (LLM Generation)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
LLM_PROVIDER="groq"
LLM_MODEL="qwen/qwen3.8-27b"

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=""
