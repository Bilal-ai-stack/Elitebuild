// =============================================================================
// ELITEBUILD — Prisma Schema
// =============================================================================
// All core entities for the construction company platform.
// Future entities (Contract, ProjectMilestone, etc.) can be added later.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication & Users
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(EDITOR)
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

model Company {
  id               String   @id @default(cuid())
  legalName        String?
  displayName      String?
  tagline          String?
  description      String?  @db.Text
  establishedYear  Int?

  logoUrl          String?
  coverImageUrl    String?

  aboutText        String?  @db.Text
  mission          String?  @db.Text
  vision           String?  @db.Text

  addressPrimary   String?
  addressSecondary String?
  city             String?
  province         String?
  country          String?

  website          String?
  email            String?
  whatsapp         String?
  phonePrimary     String?
  phoneSecondary   String?

  latitude         Float?
  longitude        Float?

  facebook         String?
  linkedin         String?
  instagram        String?
  googleMapsUrl    String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Site Settings (key-value)
// ---------------------------------------------------------------------------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?  @db.Text
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model ServiceCategory {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  services     Service[]

  @@index([slug])
  @@index([active])
}

model Service {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String?
  description      String?          @db.Text
  icon             String?
  coverImageUrl    String?
  featured         Boolean          @default(false)
  displayOrder     Int              @default(0)
  active           Boolean          @default(true)

  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
  @@index([active])
  @@index([featured])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  MAINTENANCE
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProjectCategory {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]

  @@index([slug])
  @@index([active])
}

model Project {
  id                  String          @id @default(cuid())
  title               String
  slug                String          @unique
  shortDescription    String?
  description         String?         @db.Text

  location            String?
  clientOrganization  String?

  startDate           DateTime?
  completionDate      DateTime?

  status              ProjectStatus   @default(PLANNED)
  contentStatus       ContentStatus   @default(DRAFT)

  scope               String?         @db.Text
  contractType        String?

  featured            Boolean         @default(false)
  displayOrder        Int             @default(0)

  coverImageUrl       String?

  categoryId          String?
  category            ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images              ProjectImage[]
  certificates        PerformanceCertificate[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([contentStatus])
  @@index([featured])
  @@index([categoryId])
}

model ProjectImage {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  imageUrl     String
  thumbnailUrl String?
  altText      String?
  caption      String?
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)

  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([featured])
}

// ---------------------------------------------------------------------------
// Capabilities
// ---------------------------------------------------------------------------

model Capability {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  icon         String?
  imageUrl     String?
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// ---------------------------------------------------------------------------
// Equipment
// ---------------------------------------------------------------------------

model Equipment {
  id           String   @id @default(cuid())
  name         String
  category     String?
  description  String?  @db.Text
  quantity     Int?
  imageUrl     String?
  status       String?  @default("AVAILABLE")
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Team
// ---------------------------------------------------------------------------

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  title        String?
  department   String?
  bio          String?  @db.Text
  photoUrl     String?
  email        String?
  phone        String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// ---------------------------------------------------------------------------
// Credentials & Registrations
// ---------------------------------------------------------------------------

model Credential {
  id                   String    @id @default(cuid())
  title                String
  issuingOrganization  String?
  credentialNumber     String?
  issueDate            DateTime?
  expiryDate           DateTime?
  description          String?   @db.Text
  documentUrl          String?
  imageUrl             String?
  displayOrder         Int       @default(0)
  verified             Boolean   @default(false)
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([active])
  @@index([verified])
}

// ---------------------------------------------------------------------------
// Client Organizations
// ---------------------------------------------------------------------------

model ClientOrganization {
  id           String   @id @default(cuid())
  name         String
  shortName    String?
  description  String?
  logoUrl      String?
  website      String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  certificates PerformanceCertificate[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Performance Certificates
// ---------------------------------------------------------------------------

model PerformanceCertificate {
  id           String              @id @default(cuid())
  title        String
  projectId    String?
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issuedById   String?
  issuedBy     ClientOrganization? @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issueDate    DateTime?
  description  String?             @db.Text
  documentUrl  String?
  imageUrl     String?
  verified     Boolean             @default(false)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([projectId])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  COMPANY_PROFILE
  CERTIFICATE
  REGISTRATION
  CONTRACT
  PERFORMANCE_CERTIFICATE
  TECHNICAL_DOCUMENT
  SAFETY_DOCUMENT
  TENDER_DOCUMENT
  OTHER
}

enum DocumentVisibility {
  PUBLIC
  ADMIN_ONLY
  PRIVATE
}

model Document {
  id           String             @id @default(cuid())
  title        String
  description  String?            @db.Text
  documentType DocumentType       @default(OTHER)
  fileUrl      String
  mimeType     String?
  fileSize     Int?
  visibility   DocumentVisibility @default(ADMIN_ONLY)
  uploadedBy   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([documentType])
  @@index([visibility])
}

// ---------------------------------------------------------------------------
// Contact Inquiries
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  READ
  IN_PROGRESS
  RESPONDED
  CLOSED
  SPAM
}

model ContactInquiry {
  id                     String        @id @default(cuid())
  name                   String
  organization           String?
  email                  String
  phone                  String?
  whatsapp               String?
  subject                String?
  message                String        @db.Text
  projectType            String?
  preferredContactMethod String?
  status                 InquiryStatus @default(NEW)
  notes                  String?       @db.Text
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// FAQs
// ---------------------------------------------------------------------------

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String   @db.Text
  category     String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  public       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
